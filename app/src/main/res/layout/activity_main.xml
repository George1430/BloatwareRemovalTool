<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#FFFFFF">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/samsung_bloatware"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#1565C0"
            android:paddingBottom="8dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tap_to_select"
            android:textSize="12sp"
            android:textColor="#666666"
            android:paddingBottom="12dp" />

        <Button
            android:id="@+id/auto_select_button"
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:text="@string/auto_select"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />
    </LinearLayout>

    <RadioGroup
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp">

        <RadioButton
            android:id="@+id/radio_suggested"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/suggested"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/radio_all_apps"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/all_apps"
            android:textSize="12sp" />

        <RadioButton
            android:id="@+id/radio_system"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/system_apps"
            android:textSize="12sp" />
    </RadioGroup>

    <ProgressBar
        android:id="@+id/loading_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingTop="8dp" />

    <ListView
        android:id="@+id/app_list_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbarStyle="outsideOverlay" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#FFFFFF">

        <TextView
            android:id="@+id/storage_info"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/storage_freed"
            android:textSize="12sp"
            android:textColor="#43A047"
            android:textStyle="bold"
            android:paddingBottom="8dp" />

        <Button
            android:id="@+id/uninstall_button"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="@string/uninstall_selected"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

</LinearLayout>
